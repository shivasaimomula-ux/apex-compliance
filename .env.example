# Copy to .env (or just export these) before running `npm start`.
# APEX can run on EITHER Anthropic (Claude) OR NVIDIA (Nemotron). Set at least one key.

# --- Anthropic (Claude) ---
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- NVIDIA (Nemotron) ---
# Get one at https://build.nvidia.com/  (keys start with nvapi-)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MAX_TOKENS=8192

# --- Provider selection ---
# Which provider to use. If unset, APEX auto-picks: Anthropic if its key is set,
# otherwise NVIDIA. Set this to force one (must have that provider's key).
# APEX_PROVIDER=nvidia

# --- Other optional overrides ---
# PORT=8000
# APEX_MODEL=claude-opus-4-8
